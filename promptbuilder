var currentStep=1,selectedModel=null,selectedRole=null,sequence=[],dragSrc=null,dragSrcList=null;

function showErr(id){document.getElementById(id).style.display='block';}
function hideErr(id){document.getElementById(id).style.display='none';}

function goStep(n){
  if(n===2){var g=document.getElementById('inp-goal').value.trim();if(g.length<6){showErr('err-goal');document.getElementById('inp-goal').focus();return;}hideErr('err-goal');}
  if(n===3){if(!selectedModel){showErr('err-model');return;}hideErr('err-model');}
  if(n===4){var r=getActiveRole();if(!r){showErr('err-role');return;}hideErr('err-role');}
  if(n===4)renderStep4();
  if(n===5)renderStep5();
  if(n===6)renderStep6();
  document.getElementById('panel-'+currentStep).classList.remove('active');
  currentStep=n;
  document.getElementById('panel-'+n).classList.add('active');
  renderStepBar();
  window.scrollTo(0,0);
}

function resetAll(){
  selectedModel=null;selectedRole=null;sequence=[];currentStep=1;
  ['inp-goal','inp-client','inp-context','inp-custom-role'].forEach(function(id){document.getElementById(id).value='';});
  document.getElementById('inp-datatype').value='';document.getElementById('inp-codes').value='15';
  document.querySelectorAll('.panel').forEach(function(p){p.classList.remove('active');});
  document.getElementById('panel-1').classList.add('active');
  renderStepBar();renderModelCards();renderRoleCards();
}

function renderStepBar(){
  var steps=['Project','Model','Role','Sequence','Add-ons','Prompt'];
  var bar=document.getElementById('stepbar');bar.innerHTML='';
  steps.forEach(function(label,i){
    var n=i+1,active=n===currentStep,done=n<currentStep;
    var item=document.createElement('div');item.className='step-item';
    var inner=document.createElement('div');inner.className='step-inner'+(active?' active':'');
    var num=document.createElement('div');num.className='step-num'+(done?' done':active?' active':'');num.textContent=done?'✓':n;
    var lbl=document.createElement('span');lbl.className='step-label'+(active?' active':'');lbl.textContent=label;
    inner.appendChild(num);inner.appendChild(lbl);item.appendChild(inner);
    if(i<5){var sep=document.createElement('div');sep.className='step-sep';item.appendChild(sep);}
    bar.appendChild(item);
  });
}

function renderModelCards(){
  var c=document.getElementById('model-cards');c.innerHTML='';
  MODELS.forEach(function(m){
    var card=document.createElement('div');card.className='card'+(selectedModel===m.id?' sel':'');card.onclick=function(){selectModel(m.id);};
    var row=document.createElement('div');row.className='card-row';
    var icon=document.createElement('div');icon.className='card-icon';icon.style.color=m.color;icon.textContent=m.icon;
    var body=document.createElement('div');body.className='card-body';
    var tr=document.createElement('div');tr.className='card-title-row';
    var t=document.createElement('span');t.className='card-title';t.textContent=m.label;
    var b=document.createElement('span');b.className='card-badge';b.style.color=m.color;b.style.background='rgba('+m.rgb+',0.1)';b.textContent=m.sub;
    tr.appendChild(t);tr.appendChild(b);
    var d=document.createElement('div');d.className='card-desc';d.textContent=m.desc;
    body.appendChild(tr);body.appendChild(d);
    if(m.id!=='custom'){var chips=document.createElement('div');chips.className='card-chips';m.states.forEach(function(st){var chip=document.createElement('span');chip.className='chip';chip.textContent=st.name;chips.appendChild(chip);});body.appendChild(chips);}
    var radio=document.createElement('div');radio.className='card-radio'+(selectedModel===m.id?' sel':'');
    var dot=document.createElement('div');dot.className='card-radio-dot';radio.appendChild(dot);
    row.appendChild(icon);row.appendChild(body);row.appendChild(radio);card.appendChild(row);c.appendChild(card);
  });
}

function selectModel(id){
  selectedModel=id;hideErr('err-model');
  var m=MODELS.find(function(x){return x.id===id;});
  sequence=id!=='custom'?m.states.map(function(s){return Object.assign({},s,{isAddon:false});}):[]; 
  renderModelCards();
}

function renderRoleCards(){
  var c=document.getElementById('role-cards');c.innerHTML='';
  ROLES.forEach(function(r){
    var card=document.createElement('div');card.className='role-card'+(selectedRole===r.id?' sel':'');card.onclick=function(){selectRole(r.id);};
    var row=document.createElement('div');row.className='role-card-row';
    var body=document.createElement('div');body.className='role-card-body';
    var t=document.createElement('div');t.className='role-title';t.textContent=r.title;
    var d=document.createElement('div');d.className='role-desc';d.textContent=r.desc;
    body.appendChild(t);body.appendChild(d);
    var radio=document.createElement('div');radio.className='card-radio'+(selectedRole===r.id?' sel':'');radio.style.marginTop='3px';
    var dot=document.createElement('div');dot.className='card-radio-dot';radio.appendChild(dot);
    row.appendChild(body);row.appendChild(radio);card.appendChild(row);c.appendChild(card);
  });
}

function selectRole(id){selectedRole=id;document.getElementById('inp-custom-role').value='';hideErr('err-role');renderRoleCards();}
function onCustomRoleInput(){
  var val=document.getElementById('inp-custom-role').value.trim();
  if(val.length>3){selectedRole=null;hideErr('err-role');renderRoleCards();}
}
function getActiveRole(){
  var custom=document.getElementById('inp-custom-role').value.trim();
  if(custom.length>3)return custom;
  if(selectedRole){var r=ROLES.find(function(x){return x.id===selectedRole;});return r?r.title:null;}
  return null;
}

// ── STEP 4 ────────────────────────────────────────────────────────────────
function renderStep4(){
  var isCustom=selectedModel==='custom';
  document.getElementById('step4-sub').textContent=isCustom?'Drag states from the library into your sequence. Or click the + to add them.':'Drag states to reorder your sequence. Remove any that don\'t apply.';
  var container=document.getElementById('seq-container');container.innerHTML='';
  if(isCustom){
    var layout=document.createElement('div');layout.className='seq-layout';
    var dropZone=document.createElement('div');dropZone.className='drop-zone';dropZone.id='drop-zone';
    var dzLabel=document.createElement('div');dzLabel.className='drop-zone-label';dzLabel.textContent='Your Sequence';
    dropZone.appendChild(dzLabel);
    var dzList=document.createElement('div');dzList.id='dz-list';dropZone.appendChild(dzList);
    var lib=document.createElement('div');lib.className='state-lib';
    var libLabel=document.createElement('div');libLabel.className='state-lib-label';libLabel.textContent='State Library — drag or click + to add';
    lib.appendChild(libLabel);
    var libList=document.createElement('div');libList.id='lib-list';lib.appendChild(libList);
    layout.appendChild(dropZone);layout.appendChild(lib);container.appendChild(layout);
    renderDropZone();renderLibrary();setupDropZoneDrop(dropZone);
  } else {
    var dropZone=document.createElement('div');dropZone.className='drop-zone';dropZone.id='drop-zone';
    var dzLabel=document.createElement('div');dzLabel.className='drop-zone-label';dzLabel.textContent='Your Sequence — drag to reorder';
    dropZone.appendChild(dzLabel);
    var dzList=document.createElement('div');dzList.id='dz-list';dropZone.appendChild(dzList);
    container.appendChild(dropZone);
    setupDropZoneDrop(dropZone);
    renderDropZone();
  }
}

function renderDropZone(){
  var dzList=document.getElementById('dz-list');if(!dzList)return;
  dzList.innerHTML='';
  if(sequence.length===0){
    var empty=document.createElement('div');empty.className='drop-zone-empty';
    var icon=document.createElement('div');icon.className='drop-zone-empty-icon';icon.textContent='⬡';
    var txt=document.createElement('div');txt.textContent='Drag states here to build your sequence';
    empty.appendChild(icon);empty.appendChild(txt);dzList.appendChild(empty);return;
  }
  sequence.forEach(function(st,i){dzList.appendChild(makeSeqRow(st,i));});
}

function renderLibrary(){
  var libList=document.getElementById('lib-list');if(!libList)return;libList.innerHTML='';
  var used=sequence.map(function(s){return s.id;});
  var available=ALL_STATES.filter(function(s){return used.indexOf(s.id)===-1;});
  if(available.length===0){
    var msg=document.createElement('div');msg.style.cssText='font-size:12px;color:var(--dim);padding:12px 4px;text-align:center';msg.textContent='All states are in your sequence';libList.appendChild(msg);return;
  }
  available.forEach(function(st){libList.appendChild(makeLibPill(st));});
}

function makeSeqRow(st,i){
  var row=document.createElement('div');
  row.className='state-row'+(i===0&&!st.isAddon?' first-state':'')+(st.isAddon?' addon-state':'');
  row.draggable=true;row.dataset.id=st.id;row.dataset.src='seq';
  var handle=document.createElement('div');handle.className='drag-handle';handle.textContent='⠿';
  var num=document.createElement('div');num.className='state-num'+(st.isAddon?'':' core-num');num.textContent=i+1;
  var info=document.createElement('div');info.className='state-info';
  var n=document.createElement('div');n.className='state-name'+(st.isAddon?' addon-name':'');n.textContent=st.name;
  var d=document.createElement('div');d.className='state-desc';d.textContent=st.shortDesc;
  info.appendChild(n);info.appendChild(d);
  var del=document.createElement('button');del.className='mini-btn del';del.textContent='×';del.title='Remove';
  del.onclick=(function(idx){return function(e){e.stopPropagation();removeSeqState(idx);};})(i);
  row.appendChild(handle);row.appendChild(num);row.appendChild(info);row.appendChild(del);
  row.addEventListener('dragstart',function(e){dragSrc=this;dragSrcList='seq';this.classList.add('dragging');e.dataTransfer.effectAllowed='move';e.dataTransfer.setData('text/plain',this.dataset.id);});
  row.addEventListener('dragend',function(){this.classList.remove('dragging');clearPlaceholders();});
  row.addEventListener('dragover',function(e){
    if(dragSrcList==='seq'){e.preventDefault();e.dataTransfer.dropEffect='move';
      var dz=document.getElementById('dz-list');clearPlaceholders();
      var after=getDragAfterElement(dz,e.clientY);
      var ph=makePlaceholder();if(!after){dz.appendChild(ph);}else{dz.insertBefore(ph,after);}
    }
  });
  row.addEventListener('drop',function(e){
    e.preventDefault();
    if(dragSrcList==='seq'&&dragSrc&&dragSrc!==this){
      var srcId=e.dataTransfer.getData('text/plain'),tgtId=this.dataset.id;
      var si=sequence.findIndex(function(s){return s.id===srcId;}),ti=sequence.findIndex(function(s){return s.id===tgtId;});
      if(si!==-1&&ti!==-1){var tmp=sequence[si];sequence.splice(si,1);var ni=sequence.findIndex(function(s){return s.id===tgtId;});sequence.splice(ni,0,tmp);}
      renderDropZone();
    }
  });
  return row;
}

function makeLibPill(st){
  var pill=document.createElement('div');pill.className='lib-pill';pill.draggable=true;pill.dataset.id=st.id;pill.dataset.src='lib';
  var plus=document.createElement('div');plus.className='lib-pill-plus';plus.textContent='+';
  var info=document.createElement('div');info.style.flex='1';info.style.minWidth='0';
  var n=document.createElement('div');n.style.cssText='font-size:12px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis';n.textContent=st.name;
  var d=document.createElement('div');d.style.cssText='font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis';d.textContent=st.shortDesc;
  info.appendChild(n);info.appendChild(d);pill.appendChild(plus);pill.appendChild(info);
  pill.addEventListener('click',function(){sequence.push(Object.assign({},st,{isAddon:false}));renderDropZone();renderLibrary();});
  pill.addEventListener('dragstart',function(e){dragSrc=this;dragSrcList='lib';this.classList.add('dragging');e.dataTransfer.effectAllowed='copy';e.dataTransfer.setData('text/plain',this.dataset.id);});
  pill.addEventListener('dragend',function(){this.classList.remove('dragging');clearPlaceholders();var dz=document.getElementById('drop-zone');if(dz)dz.classList.remove('drag-over');});
  return pill;
}

function setupDropZoneDrop(dz){
  dz.addEventListener('dragover',function(e){
    e.preventDefault();dz.classList.add('drag-over');
    if(dragSrcList==='lib'){
      e.dataTransfer.dropEffect='copy';
      var dzList=document.getElementById('dz-list');
      var after=getDragAfterElement(dzList,e.clientY);clearPlaceholders();
      var ph=makePlaceholder();if(!after){dzList.appendChild(ph);}else{dzList.insertBefore(ph,after);}
    } else if(dragSrcList==='seq'){e.dataTransfer.dropEffect='move';}
  });
  dz.addEventListener('dragleave',function(e){if(!dz.contains(e.relatedTarget)){dz.classList.remove('drag-over');clearPlaceholders();}});
  dz.addEventListener('drop',function(e){
    e.preventDefault();dz.classList.remove('drag-over');clearPlaceholders();
    var id=e.dataTransfer.getData('text/plain');
    if(dragSrcList==='lib'){
      var st=ALL_STATES.find(function(s){return s.id===id;});
      if(st&&!sequence.find(function(s){return s.id===id;})){
        var dzList=document.getElementById('dz-list');
        var after=getDragAfterElement(dzList,e.clientY);
        var insertIdx=sequence.length;
        if(after&&after.dataset.id){var ai=sequence.findIndex(function(s){return s.id===after.dataset.id;});if(ai!==-1)insertIdx=ai;}
        sequence.splice(insertIdx,0,Object.assign({},st,{isAddon:false}));
        renderDropZone();renderLibrary();
      }
    } else if(dragSrcList==='seq'){
      var si=sequence.findIndex(function(s){return s.id===id;});
      if(si!==-1){
        var dzList=document.getElementById('dz-list');
        var after=getDragAfterElement(dzList,e.clientY);
        var tmp=sequence.splice(si,1)[0];
        var insertIdx=sequence.length;
        if(after&&after.dataset.id){var ai=sequence.findIndex(function(s){return s.id===after.dataset.id;});if(ai!==-1)insertIdx=ai;}
        sequence.splice(insertIdx,0,tmp);renderDropZone();
      }
    }
  });
}

function makePlaceholder(){var ph=document.createElement('div');ph.className='drag-placeholder';ph.dataset.placeholder='1';return ph;}
function clearPlaceholders(){document.querySelectorAll('[data-placeholder]').forEach(function(el){el.remove();});}
function getDragAfterElement(container,y){
  var els=[].slice.call(container.querySelectorAll('.state-row:not(.dragging):not(.drag-placeholder),.lib-pill:not(.dragging)'));
  var closest=null,closestOffset=Number.NEGATIVE_INFINITY;
  els.forEach(function(el){var box=el.getBoundingClientRect();var offset=y-(box.top+box.height/2);if(offset<0&&offset>closestOffset){closestOffset=offset;closest=el;}});
  return closest;
}
function removeSeqState(i){sequence.splice(i,1);renderDropZone();if(selectedModel==='custom')renderLibrary();}

// ── STEP 5 ────────────────────────────────────────────────────────────────
function renderStep5(){
  renderDropZone();
  var grid=document.getElementById('addon-grid');grid.innerHTML='';
  ADDONS.forEach(function(addon){
    var sel=sequence.some(function(s){return s.id===addon.id;});
    var card=document.createElement('div');card.className='addon-card'+(sel?' sel':'');card.onclick=(function(a){return function(){toggleAddon(a);};})(addon);
    var top=document.createElement('div');top.className='addon-card-top';
    var tag=document.createElement('span');tag.className='addon-tag';tag.style.color=addon.tagColor;tag.style.background=addon.tagBg;tag.textContent=addon.tag;
    var check=document.createElement('div');check.className='addon-check'+(sel?' sel':'');check.textContent=sel?'✓':'';
    top.appendChild(tag);top.appendChild(check);
    var n=document.createElement('div');n.className='addon-name';n.textContent=addon.name;
    var w=document.createElement('div');w.className='addon-when';w.textContent=addon.whenToUse;
    card.appendChild(top);card.appendChild(n);card.appendChild(w);grid.appendChild(card);
  });
  renderFullSeq();
}

function toggleAddon(addon){
  var idx=sequence.findIndex(function(s){return s.id===addon.id;});
  if(idx!==-1){sequence.splice(idx,1);}else{sequence.push(Object.assign({},addon,{isAddon:true}));}
  renderStep5();
}

function renderFullSeq(){
  var addons=sequence.filter(function(s){return s.isAddon;});
  var sec=document.getElementById('full-seq-section'),list=document.getElementById('full-seq-list');
  if(addons.length===0){sec.style.display='none';return;}
  sec.style.display='';list.innerHTML='';
  sequence.forEach(function(st,i){
    var row=document.createElement('div');row.className='state-row'+(st.isAddon?' addon-state':'');
    var handle=document.createElement('div');handle.className='drag-handle';handle.textContent='⠿';
    var num=document.createElement('div');num.className='state-num'+(st.isAddon?'':' core-num');num.textContent=i+1;
    var info=document.createElement('div');info.className='state-info';
    var n=document.createElement('div');n.className='state-name'+(st.isAddon?' addon-name':'');n.textContent=st.name;
    var b=document.createElement('div');b.className='state-badge';b.textContent=st.isAddon?'ADD-ON':'CORE';
    info.appendChild(n);info.appendChild(b);row.appendChild(handle);row.appendChild(num);row.appendChild(info);
    if(st.isAddon){
      var u=document.createElement('button');u.className='mini-btn';u.textContent='↑';u.disabled=i===0;u.onclick=(function(idx){return function(e){e.stopPropagation();moveSeq(idx,-1);};})(i);
      var dw=document.createElement('button');dw.className='mini-btn';dw.textContent='↓';dw.disabled=i===sequence.length-1;dw.onclick=(function(idx){return function(e){e.stopPropagation();moveSeq(idx,1);};})(i);
      row.appendChild(u);row.appendChild(dw);
    }
    list.appendChild(row);
  });
}

function moveSeq(i,dir){var j=i+dir;if(j<0||j>=sequence.length)return;var t=sequence[i];sequence[i]=sequence[j];sequence[j]=t;renderFullSeq();}

// ── STEP 6 ────────────────────────────────────────────────────────────────
function renderStep6(){
  var goal=document.getElementById('inp-goal').value.trim();
  var client=document.getElementById('inp-client').value.trim();
  var context=document.getElementById('inp-context').value.trim();
  var dataType=document.getElementById('inp-datatype').value;
  var numCodes=document.getElementById('inp-codes').value||'15';
  var role=getActiveRole();
  var modelLabel=selectedModel==='associate'?'The Associate':selectedModel==='apprentice'?'The Apprentice':'Custom Build';
  var coreN=sequence.filter(function(s){return !s.isAddon;}).length;
  var addonN=sequence.filter(function(s){return s.isAddon;}).length;
  var chips=document.getElementById('meta-chips');chips.innerHTML='';
  [['Goal',goal.length>55?goal.substring(0,55)+'...':goal],['Role',role||'—'],['Model',modelLabel],['Stages',coreN+' core'+(addonN>0?' + '+addonN+' add-on'+(addonN>1?'s':''):'')]].forEach(function(pair){
    var chip=document.createElement('div');chip.className='meta-chip';
    var lbl=document.createElement('div');lbl.className='meta-chip-label';lbl.textContent=pair[0];
    var val=document.createElement('div');val.className='meta-chip-val';val.textContent=pair[1];
    chip.appendChild(lbl);chip.appendChild(val);chips.appendChild(chip);
  });
  var xml=sequence.map(function(st,i){
    var g=st.goal.replace('[NUMBER_OF_CODES]',numCodes).replace(/\[GOAL\]/g,goal);
    var a=st.action.replace(/\[GOAL\]/g,goal);
    return '\n    <STATE_'+(i+1)+'>\n      <n>'+st.name+'</n>\n      <GOAL>'+g+'</GOAL>\n      <DATA_INPUT>'+st.dataInput+'</DATA_INPUT>\n      <ACTION>'+a+'</ACTION>\n      <EXIT_CRITERIA>'+st.exit+'</EXIT_CRITERIA>\n    </STATE_'+(i+1)+'>';
  }).join('');
  var roleLine=role?'You are a '+role+'.':'You are a Senior UX Research Lead.';
  var prompt='<MASTER_SYSTEM_PROMPT>\n\n  <SYSTEM_IDENTITY>\n    '+roleLine+' Your goal is to conduct a rigorous qualitative analysis'+(client?' for '+client:'')+' to '+goal+'.\n  </SYSTEM_IDENTITY>\n\n  <PROJECT_CONTEXT>'+(client?'\n    <CLIENT>'+client+'</CLIENT>':'')+'\n    <GOAL>'+goal+'</GOAL>'+(context?'\n    <BACKGROUND>'+context+'</BACKGROUND>':'')+(dataType?'\n    <DATA_TYPE>'+dataType+'</DATA_TYPE>':'')+'\n    <TARGET_CODES>'+numCodes+'</TARGET_CODES>\n  </PROJECT_CONTEXT>\n\n  <OPERATIONAL_LOGIC>\n    <VERACITY_PROTOCOL>\n      1. Never paraphrase. All quotes must be verbatim from the transcript.\n      2. TRACEABILITY: Every quote MUST be accompanied by a Participant ID and Timestamp (e.g., "P01 [04:12]").\n      3. If the raw data lacks Participant IDs, use the transcript filename or a sequential identifier (User 1, User 2).\n    </VERACITY_PROTOCOL>\n\n    <AMBIGUITY_PROTOCOL>\n      1. NO GUESSING. If a transcript excerpt is unclear or sits on a border, DO NOT assign a code.\n      2. BATCHING. Mark unclear segments as [QUERY_FOR_HUMAN] and provide them at the end of each State.\n    </AMBIGUITY_PROTOCOL>\n\n    <STATE_DEFINITIONS>'+xml+'\n    </STATE_DEFINITIONS>\n\n    <CURRENT_STATE>State 1 - '+(sequence[0]?sequence[0].name:'Begin')+' (Awaiting data upload)</CURRENT_STATE>\n\n    <OUTPUT_FORMAT>\n| ID | Participant [Timestamp] | Verbatim Quote | Applied Code | Rationale | Confidence (1-10) |\n    </OUTPUT_FORMAT>\n  </OPERATIONAL_LOGIC>\n\n</MASTER_SYSTEM_PROMPT>';
  document.getElementById('prompt-out').value=prompt;
}

function copyPrompt(){
  var ta=document.getElementById('prompt-out'),btn=document.getElementById('copy-btn');
  try{navigator.clipboard.writeText(ta.value);}catch(e){ta.select();document.execCommand('copy');}
  btn.textContent='✓ Copied!';btn.classList.add('copied');
  setTimeout(function(){btn.textContent='Copy';btn.classList.remove('copied');},2500);
}

renderStepBar();renderModelCards();renderRoleCards();
</script>
